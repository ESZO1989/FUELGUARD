# Copie este archivo a .env y ajuste. Se carga con: npm run start:prod  (node --env-file=.env)

# Puerto y dirección de escucha. Detrás de Caddy/Nginx use HOST=127.0.0.1.
PORT=3000
HOST=0.0.0.0

# Ruta de la base SQLite. Fuera de OneDrive/Dropbox y con respaldo.
FUELGUARD_DB=./data/fuelguard.db

# Semilla al crear una base nueva: "demo" (datos de prueba) o "minimo" (solo admin, producción).
FUELGUARD_SEED=minimo
FUELGUARD_EMPRESA=Mi Empresa
# PIN inicial del admin (4-8 dígitos). Si se omite, se genera uno aleatorio y se imprime al arrancar.
FUELGUARD_ADMIN_PIN=

# HTTPS nativo (opcional). Con Caddy/Nginx delante déjelo vacío y ponga TRUST_PROXY=1.
TLS_CERT=
TLS_KEY=
TRUST_PROXY=0

# Respaldos automáticos (diario a la hora del parámetro backup_hora).
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Correo para reportes automáticos (opcional). Sin SMTP_HOST el envío queda desactivado.
# Gmail: smtp.gmail.com, puerto 587, usuario y "contraseña de aplicación". Microsoft 365: smtp.office365.com, 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FuelGuard <reportes@miempresa.com>
# SMTP_TLS_INSECURE=1 solo para servidores internos con certificado autofirmado
